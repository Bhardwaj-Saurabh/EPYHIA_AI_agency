# EPYHIA environment variables
#
# Local dev: copy to .env and fill in (never committed - .env is git-ignored).
# Production: each variable is set ONLY on its owning Fly app via `fly secrets set`.
# The split below IS the credential boundary from DESIGN.md: Tier 1 and Tier 2
# hold no provider credentials of any kind.

# ------------------------------------------------------------------
# TIER 3 - ACTION GATE (apps/gate) - the ONLY holder of provider keys
# ------------------------------------------------------------------

# Neon Postgres - connection string from console.neon.tech (use the pooled one)
DATABASE_URL=
# Azure OpenAI / Microsoft Foundry - portal: your Azure OpenAI resource
# Deploy GPT-5.6 Sol, Terra and Luna, then record each deployment name
# (e.g. gpt-5.6-sol / gpt-5.6-terra / gpt-5.6-luna).
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_DEPLOYMENT_SOL=
AZURE_OPENAI_DEPLOYMENT_TERRA=
AZURE_OPENAI_DEPLOYMENT_LUNA=

# Cloudflare - dash.cloudflare.com > My Profile > API Tokens
# Token scoped to: Account > Cloudflare Pages > Edit
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=

# Stripe TEST MODE keys only - dashboard.stripe.com/test/apikeys
# (sk_test_...; webhook secret appears when you create the webhook endpoint)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Cloudflare R2 (video/binary artifacts) - dash.cloudflare.com > R2 > API tokens
# Needed in week 2 (Marketer video output); leave empty until then.
R2_ENDPOINT=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=

# Veo via kdowswell/veo-tools (Google AI Studio key) - week 2, leave empty.
GOOGLE_AI_API_KEY=

# Mail catcher endpoint for /publish email output - week 2, leave empty.
MAIL_CATCHER_URL=

# Gate behavior
GATE_PORT=8082
# Global safety default: every action runs in TEST mode (DESIGN.md section 1).
RUN_MODE=TEST

# ------------------------------------------------------------------
# TIER 2 - AGENT WORKERS (apps/workers) - no credentials
# ------------------------------------------------------------------

WORKERS_PORT=8081
# Where the workers reach the gate. Local dev: localhost. On Fly: the gate
# app's private .internal address (no public ingress).
GATE_URL=http://localhost:8082

# ------------------------------------------------------------------
# TIER 1 - PUBLIC API GATEWAY (apps/gateway) - no credentials
# ------------------------------------------------------------------

GATEWAY_PORT=8080
# Where the gateway reaches the workers (Fly private address in prod).
WORKERS_URL=http://localhost:8081

# Auth0 - manage.auth0.com > create a Single Page Application
# The API validates tokens; the SPA gets its own VITE_-prefixed copies at build time.
AUTH0_DOMAIN=
AUTH0_AUDIENCE=
VITE_AUTH0_DOMAIN=
VITE_AUTH0_CLIENT_ID=

# ------------------------------------------------------------------
# LOCAL DEV NOTES
# ------------------------------------------------------------------
# - Stripe webhooks locally: `stripe listen --forward-to localhost:8080/webhooks/stripe`
#   (prints the whsec_... value to use as STRIPE_WEBHOOK_SECRET locally)
# - Nothing above is needed to run the health-check skeletons; fill in
#   DATABASE_URL + Cloudflare first (gate milestone), Azure next (Strategist).
